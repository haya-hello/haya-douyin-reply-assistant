{
  "mode": "on_demand",
  "background_monitoring": false,
  "reply_window_days": 3,
  "reply_window_basis": "rolling_72_hours_from_source_message_time",
  "missing_or_future_timestamp": "skip",
  "history_learning_window_days": null,
  "send_on_explicit_reply_request": true,
  "per_message_confirmation": false,
  "comment_max_auto_replies_per_thread": 1,
  "dm_max_auto_replies_per_conversation": 2,
  "dm_second_reply_requires_new_inbound": true,
  "reply_counts_persist_across_runs": true,
  "minimum_model_confidence": "high",
  "uncertain_content": "persist_handoff_for_user",
  "max_replies_per_run": 5,
  "minimum_interval_seconds": 60,
  "interval_is_not_a_safety_guarantee": true,
  "comments_scope": "own_videos_only",
  "dm_scope": "existing_inbound_conversations_only",
  "uncertain_delivery": "stop_without_retry",
  "ambiguous_or_sensitive_content": "hold",
  "history_is_style_reference_not_verified_facts": true
}
